# LLM Provider: "gemini" atau "ollama"
LLM_PROVIDER=ollama

# Gemini Settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
