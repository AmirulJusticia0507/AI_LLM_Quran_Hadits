# LLM Provider: "griphub", "gemini" atau "ollama"
LLM_PROVIDER=ollama

# GripHub Router (OpenAI-compatible, key hanya di backend)
GRIPHUB_BASE_URL=https://griphubrouter.web.id/v1
GRIPHUB_API_KEY=
GRIPHUB_MODEL=gpt-5.6-luna
GRIPHUB_HISTORY_MESSAGES=8

# Gemini Settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Neon PostgreSQL (backend only; gunakan pooled connection string)
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
