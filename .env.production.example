# LLM Provider: "griphub", "gemini" atau "ollama"
LLM_PROVIDER=griphub

# GripHub Router (WAJIB isi key dan model slug di production)
GRIPHUB_BASE_URL=https://griphubrouter.web.id/v1
GRIPHUB_API_KEY=your_api_key_here
GRIPHUB_MODEL=gpt-5.6-luna
GRIPHUB_HISTORY_MESSAGES=8

# Gemini Settings (WAJIB isi di production)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Ollama Settings (fallback, tidak dipakai di cloud kecuali deploy Ollama terpisah)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b

# CORS - GANTI dengan domain Vercel frontend Anda
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
